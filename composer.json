    "authors": [
        {
            "name": "Roshan Nagaju",
            "email": "rosannagaju@gmail.com"
        }
    ],
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
